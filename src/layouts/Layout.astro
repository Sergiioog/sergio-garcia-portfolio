---
import "../styles/reset.scss";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/logo.png" />
		<link rel="icon" href="/logo.png" />
		<meta name="generator" content={Astro.generator} />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<title>Sergio Garcia | Web Developer</title>
	</head>
	<body>
		<div class="background">
			<div class="blob"></div>
		</div>
		<main class="app">
			<slot />
		</main>
	</body>
</html>

<style>
	html,
	body {
		/* height: 10000px; Descomment to make tryials */
		height: 100%;
		margin: 0;
		font-family: 'Inter', sans-serif;
	}

	body {
		background-color: white;
	}

	.background {
		height: 100%;
		width: 100%;
		position: fixed;
		top: 0;
		left: 0;
		pointer-events: none;
		overflow: hidden;
	}

	.blob {
		height: 500px;
		width: 500px;
		position: absolute;
		top: 0;
		right: 0;
		transform: translate(-150px, 100px);
		background-color: rgba(46, 138, 243, 0.5);
		border-radius: 50%;
		filter: blur(80px);
		opacity: 0.5;
	}

	:root {
		--blob-color: 59, 130, 246;
	}

	.blob {
		background-color: rgba(var(--blob-color), 0.5);
	}
	.app {
		position: relative;
	}
	
</style>
